<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder auto-import-default-references="false" auto-namespace-tables="false" change-tracking-enabled="true" dependency-injector="ds" mvcc-enabled="true" package-path="com.liferay.asset">
	<namespace>Asset</namespace>
	<entity local-service="true" name="AssetVocabularyDepotEntryRel" remote-service="true" uuid="true">

		<!-- PK fields -->

		<column name="assetVocabularyDepotEntryRelId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />

		<!-- Other fields -->

		<column name="assetVocabularyId" type="long" />
		<column name="depotEntryId" type="long" />

		<!-- Finder methods -->

		<finder name="AssetVocabularyId" return-type="Collection">
			<finder-column name="assetVocabularyId" />
		</finder>
		<finder name="DepotEntryId" return-type="Collection">
			<finder-column name="depotEntryId" />
		</finder>
		<finder name="AVI_DEI" return-type="AssetVocabularyDepotEntryRel">
			<finder-column name="assetVocabularyId" />
			<finder-column name="depotEntryId" />
		</finder>
	</entity>
	<exceptions>
		<exception>InvalidAssetVocabularyDepotEntryRel</exception>
	</exceptions>
</service-builder>