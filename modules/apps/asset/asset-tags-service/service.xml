<?xml version="1.0"?>
<!DOCTYPE service-builder PUBLIC "-//Liferay//DTD Service Builder 7.4.0//EN" "http://www.liferay.com/dtd/liferay-service-builder_7_4_0.dtd">

<service-builder auto-import-default-references="false" auto-namespace-tables="false" change-tracking-enabled="true" dependency-injector="ds" mvcc-enabled="true" package-path="com.liferay.asset.tags">
	<namespace>AssetTag</namespace>
	<entity local-service="true" name="AssetTagDepotEntryRel" remote-service="true" uuid="true">

		<!-- PK fields -->

		<column name="assetTagDepotEntryRelId" primary="true" type="long" />

		<!-- Audit fields -->

		<column name="companyId" type="long" />

		<!-- Other fields -->

		<column name="assetTagId" type="long" />
		<column name="depotEntryId" type="long" />

		<!-- Finder methods -->

		<finder name="AssetTagId" return-type="Collection">
			<finder-column name="assetTagId" />
		</finder>
		<finder name="DepotEntryId" return-type="Collection">
			<finder-column name="depotEntryId" />
		</finder>
		<finder name="AVI_DEI" return-type="AssetTagDepotEntryRel">
			<finder-column name="assetTagId" />
			<finder-column name="depotEntryId" />
		</finder>
	</entity>
	<exceptions>
		<exception>InvalidAssetTagDepotEntryRel</exception>
	</exceptions>
</service-builder>